{
  "manifest_version": 3,
  "name": "NOVA Wallet",
  "version": "1.0.0",
  "description": "Premium self-custodial crypto wallet for Solana and EVM.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open NOVA"
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/inpage.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
